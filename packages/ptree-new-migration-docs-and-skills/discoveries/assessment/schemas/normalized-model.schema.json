{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partstree.local/schemas/normalized-model.schema.json",
  "title": "Normalized model (type=model) intermediate row",
  "type": "object",
  "required": [
    "source_id",
    "entity_type",
    "workflow_status",
    "shopware_target_decision"
  ],
  "properties": {
    "source_id": { "type": "string" },
    "entity_type": { "const": "model" },
    "model_name": { "type": ["array", "null"], "items": { "type": "string" } },
    "product_family": { "type": ["array", "null"], "items": { "type": "string" } },
    "workflow_status": {
      "type": "string",
      "enum": ["loadable", "skipped_deleted", "skipped_unapproved", "blocked_od01_mapping"]
    },
    "shopware_target_decision": {
      "type": "string",
      "enum": ["UNDECIDED_OD01", "category", "custom_entity"],
      "description": "Assessment runs fail on UNDECIDED_OD01 per mapping contract"
    },
    "ipl_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "brand_keys": { "type": "array", "items": { "type": "string" } },
    "photos_refs": { "type": "array", "items": { "type": "string" } },
    "payload_hash": { "type": "string" }
  }
}
